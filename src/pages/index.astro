---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Home is the Hebrew "use it" layer: open the app in one tap. The technical
// write-ups (English) live one click away at /projects/<slug>/.
const projects = (await getCollection('projects'))
  .filter((p) => p.data.liveUrl)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Chen's Projects"
  ogImage="/og.jpg"
  lang="he"
  dir="rtl"
>
  <div class="split" dir="ltr">
    <header class="hero" lang="en">
      <div>
        <h1>Chen's<br />Projects</h1>
        <div class="contact">
          <p>Contact me:</p>
          <ul>
            <li>
              <a href="https://www.linkedin.com/in/chen-m/">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.878 1.637-1.805 3.37-1.805 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a href="https://x.com/chen12m">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" /></svg>
                X
              </a>
            </li>
          </ul>
          <button type="button" class="theme" id="theme-toggle">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v2M12 20.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1.5 12h2M20.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
            <span class="label">Dark mode</span>
          </button>
        </div>
      </div>
      <footer>
        Built with <a href="https://claude.com/claude-code">Claude Code</a>
      </footer>
    </header>

    <main class="index" dir="rtl">
      {projects.map((p, i) => (
        <article class="app">
          {p.data.screenshot && (
            <a class="shot" href={p.data.liveUrl} tabindex="-1" aria-hidden="true">
              <img src={p.data.screenshot} alt="" width="390" height="844" loading={i === 0 ? 'eager' : 'lazy'} />
            </a>
          )}
          <div class="head">
            {p.data.icon ? (
              <img class="icon" src={p.data.icon} alt="" width="64" height="64" />
            ) : (
              <div class="icon placeholder" aria-hidden="true">{(p.data.titleHe ?? p.data.title).slice(0, 1)}</div>
            )}
            <div>
              <h2>{p.data.titleHe ?? p.data.title}</h2>
              <p class="tagline">{p.data.taglineHe ?? p.data.description}</p>
            </div>
          </div>
          <a class="url" href={p.data.liveUrl} dir="ltr">{new URL(p.data.liveUrl!).host}</a>
          <div class="actions">
            <a class="open" href={p.data.liveUrl}>פתיחה <span aria-hidden="true">←</span></a>
            <a class="how" href={`/projects/${p.id}/`} dir="ltr" lang="en">How it's built</a>
          </div>
        </article>
      ))}
    </main>
  </div>
</Base>

<script>
  const btn = document.getElementById('theme-toggle')!;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;
  const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  // The button offers the other mode: "Dark mode" while light, and vice versa.
  const render = () => {
    const dark = current() === 'dark';
    btn.dataset.mode = dark ? 'dark' : 'light';
    btn.querySelector('.label')!.textContent = dark ? 'Light mode' : 'Dark mode';
  };

  btn.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    render();
  });
  media.addEventListener('change', render);
  render();
</script>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(18rem, 2fr) 3fr;
    min-height: 100dvh;
  }
  @media (width < 52rem) {
    .split { grid-template-columns: 1fr; }
    .hero { min-height: auto; }
  }

  .hero {
    background: linear-gradient(160deg, var(--panel), var(--panel2));
    color: #fff;
    padding: clamp(2rem, 6vw, 4rem);
    display: grid;
    align-content: space-between;
    gap: 2rem;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    margin: 0;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .contact { margin-top: 1.25rem; font-size: 1.05rem; }
  .contact p { margin: 0 0 .4rem; opacity: .85; }
  .contact ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .contact a {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .contact a:hover, .contact a:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  .contact svg { width: 1.1em; height: 1.1em; fill: currentColor; }

  .theme {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: 1.25rem;
    padding: .4rem .9rem;
    border: 1px solid rgb(255 255 255 / .45);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: .9rem;
    cursor: pointer;
  }
  .theme:hover, .theme:focus-visible { background: rgb(255 255 255 / .12); }
  .theme svg { width: 1.05em; height: 1.05em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme:not([data-mode="dark"]) .sun, .theme[data-mode="dark"] .moon { display: none; }
  .hero footer { font-size: .85rem; opacity: .85; }
  .hero footer a { color: #fff; }

  .index {
    padding: clamp(1.5rem, 5vw, 4rem);
    display: grid;
    align-content: center;
    gap: 1.25rem;
  }

  .app {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "shot head" "shot url" "shot actions";
    gap: .9rem 1.25rem;
    align-items: start;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }
  @media (width < 30rem) {
    .app {
      grid-template-columns: 7rem 1fr;
      grid-template-rows: auto auto 1fr;
      grid-template-areas: "head head" "shot url" "shot actions";
      padding: 1rem;
    }
    .actions { flex-direction: column; align-items: start; gap: .75rem; }
    .url { font-size: .75rem; }
  }
  .shot { grid-area: shot; }
  .head { grid-area: head; }
  .url { grid-area: url; }
  .actions { grid-area: actions; }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: .75rem;
    border: 1px solid var(--border);
  }
  .head { display: flex; align-items: center; gap: 1rem; }
  .icon {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .icon.placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(140deg, var(--panel), var(--panel2));
    color: #fff;
    font-size: 1.8rem;
    font-weight: 800;
  }
  h2 { margin: 0; font-size: 1.35rem; line-height: 1.25; }
  .tagline { margin: .2rem 0 0; color: var(--muted); font-size: 1rem; }
  .url {
    justify-self: start;
    font-family: ui-monospace, monospace;
    font-size: .85rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .url:hover { color: var(--link); text-decoration: underline; }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .open {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 3rem;
    padding-inline: 1.6rem;
    border-radius: 999px;
    background: var(--panel);
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: background .15s ease, translate .15s ease;
  }
  .open:hover, .open:focus-visible { background: var(--panel2); translate: 0 -1px; }
  .how {
    font-size: .88rem;
    color: var(--muted);
    text-underline-offset: 3px;
  }
  .how:hover { color: var(--link); }
</style>
