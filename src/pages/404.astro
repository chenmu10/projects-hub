---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Chen's Projects" description="Page not found">
  <main class="wrap">
    <h1>Page not found</h1>
    <p><a href="/">← Chen's Projects</a></p>
  </main>
</Base>

<style>
  .wrap {
    width: min(44rem, 100% - 3rem);
    margin-inline: auto;
    padding-block: clamp(2rem, 10vh, 6rem);
  }
  h1 { margin: 0 0 1rem; font-size: clamp(1.9rem, 5vw, 2.6rem); letter-spacing: -0.02em; }
  a { font-weight: 600; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
